# Dataset and generated artifacts
/data/
/datasets/
/open/train_unlabeled.jsonl
/artifacts/
/runs/
# 후보 모듈은 소스이므로 추적하고, 그 폴더에 생기는 실험 산출물은 계속 무시한다.
# 디렉터리째 무시하면 하위 파일을 되살릴 수 없어 `/experiments/*` 로 적는다.
# 하위 폴더도 되살려야 한다 — 무시된 디렉터리 안의 파일은 되살릴 수 없으므로
# `!/experiments/*/` 가 없으면 `experiments/<티켓>/후보.py` 가 조용히 사라진다.
/experiments/**
!/experiments/**/
!/experiments/**/*.py
/checkpoints/
/weights/
/predictions/
/registry/
/submissions/
/final-models/

# 진단 화면(web/). 소스만 추적하고 설치물과 build_report.py 생성물은 뺀다.
/web/node_modules/
/web/dist/
/web/public/runs/
/web/public/items.json
# --share 요약은 같은 회차에 다시 뽑으면 덮어쓴다. score/ 는 기존 디렉터리를 거부해
# 한 번만 생기지만 이건 아니라서, 추적하면 돌릴 때마다 트리가 더러워진다.
/reports/runs/*/share.html

# Model files
*.pt
*.pth
*.ckpt
*.onnx

# TensorBoard and training logs
events.out.tfevents.*
/tensorboard/
/logs/

