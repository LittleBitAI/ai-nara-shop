# Dataset and generated artifacts
/data/
/datasets/
/open/train_unlabeled.jsonl
/artifacts/
/runs/
# 후보 모듈은 소스이므로 추적하고, 그 폴더에 생기는 실험 산출물은 계속 무시한다.
# 디렉터리째 무시하면 하위 파일을 되살릴 수 없어 `/experiments/*` 로 적는다.
# 하위 폴더도 되살려야 한다 — 무시된 디렉터리 안의 파일은 되살릴 수 없으므로
# `!/experiments/*/` 가 없으면 `experiments/<티켓>/후보.py` 가 조용히 사라진다.
/experiments/**
!/experiments/**/
!/experiments/**/*.py
# wiki-rag 의 페이지·span 명세는 실행 산출물이 아니라 고정 입력 자산이다.
# 확장자가 .py 가 아니라서 위 규칙으로는 조용히 빠진다.
!/experiments/wiki-rag/*.md
!/experiments/wiki-rag/*.json
/checkpoints/
/weights/
/predictions/
/registry/
/submissions/
/final-models/

# 진단 화면(web/). 소스만 추적하고 설치물과 build_report.py 생성물은 뺀다.
/web/node_modules/
/web/dist/
# Vite 의존성 캐시. 기본 자리는 `node_modules/.vite` 라 위 규칙이 이미 덮지만,
# `npm install` 전에 vite 가 돌면 `node_modules` 가 없어 `web/.vite` 로 떨어진다.
# `_metadata.json` 이 lockfileHash·configHash 를 담아 한 기계의 설치 상태에 묶이므로
# 추적하면 낡은 캐시가 재최적화를 건너뛰게 만든다. 소스가 이 경로를 참조하지 않는다.
/web/.vite/
/web/public/runs/
/web/public/items.json
/web/public/laws.json
# --share 요약은 같은 회차에 다시 뽑으면 덮어쓴다. score/ 는 기존 디렉터리를 거부해
# 한 번만 생기지만 이건 아니라서, 추적하면 돌릴 때마다 트리가 더러워진다.
/reports/runs/*/share.html

