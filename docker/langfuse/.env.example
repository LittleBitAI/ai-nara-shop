# 대회용 로컬 Langfuse 의 설정 본. `tools/langfuse_local.py up` 이 처음 뜰 때
# 이 파일을 옆의 `.env` 로 복사하고 CHANGEME 자리를 난수로 채운다.
# `.env` 는 git-ignore 된다 - 비밀값을 저장소에 넣지 않는다.
#
# 바꿀 만한 것은 포트와 프로젝트 이름뿐이다.

# --- 붙는 자리 -------------------------------------------------------------
# Colab 사이드카와 팀원 브라우저가 쓰는 주소.
#   LANGFUSE_HOST=http://localhost:3002        (이 기계에서 볼 때)
#   LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY = 아래 INIT 키 그대로
#
# 터널로 팀에 열면 `tools/langfuse_local.py share` 가 이 줄을 그때의
# trycloudflare 주소로 바꿔 쓰고 웹 컨테이너를 다시 만든다. NextAuth 는
# 브라우저가 실제로 쓰는 주소와 이 값이 다르면 로그인을 거부한다.
NEXTAUTH_URL=http://localhost:3002

# --- 첫 기동에 만들 조직·프로젝트·계정 -------------------------------------
# **이 인스턴스에는 조직 하나·프로젝트 하나만 둔다.**
# Langfuse 의 프로젝트 단위 역할은 유료 기능이라, 무료 셀프호스트에서 조직
# 멤버는 그 조직의 **모든 프로젝트를 본다.** 여기에 다른 프로젝트를 만들면
# 팀원에게 그것도 보인다. 다른 용도의 트레이스는 다른 스택으로 보낸다.
LANGFUSE_INIT_ORG_ID=nara
LANGFUSE_INIT_ORG_NAME=ai-nara-shop
LANGFUSE_INIT_PROJECT_ID=ai-nara-shop
LANGFUSE_INIT_PROJECT_NAME=ai-nara-shop
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-nara-000000000000000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME_INIT_SECRET
# 이 계정은 **관리자(Owner)** 다. 팀원과 공유하지 않는다. 팀원은 UI 에서
# Member 나 Viewer 로 따로 초대한다.
# `owner@localhost` 는 거부된다 - 초기화 스키마가 TLD 를 요구한다.
LANGFUSE_INIT_USER_EMAIL=owner@example.com
LANGFUSE_INIT_USER_NAME=Owner
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_INIT_PASSWORD

# --- 비밀값 ---------------------------------------------------------------
# 셋 다 `openssl rand -hex 32`. ENCRYPTION_KEY 는 **정확히 64 hex** 여야 한다.
NEXTAUTH_SECRET=CHANGEME_NEXTAUTH_SECRET
SALT=CHANGEME_SALT
ENCRYPTION_KEY=CHANGEME_ENCRYPTION_KEY

# --- 저장소 넷 ------------------------------------------------------------
# 전부 컨테이너 안에서만 닿는다. Postgres 는 호스트에 안 열린다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGEME_POSTGRES_PASSWORD@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE_PASSWORD

REDIS_AUTH=CHANGEME_REDIS_PASSWORD

MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME_MINIO_PASSWORD

# --- 이 기계에서 끄는 것 ---------------------------------------------------
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
