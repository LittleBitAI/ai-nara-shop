{"id": "PPS-D-017522", "model": "luna-high-focus-v3", "facts": {"v1_limits": [{"quote": "물품 운송에 필요한 냉장·냉동장치가 설치된 차량소유 사업자(냉장⋅냉동탑차로 납품, 차량내부 온도를 확인할 수 있는 온도계 비치)", "kind": "facility_equipment_staff", "private_firms_allowed": true, "statute_quote": null, "need_quote": null, "special_quote": null}], "sw_project_quote": null, "sw_provider_quote": null, "sw_floor_statement_quote": null, "sw_referenced_missing": false, "정보부족": false, "정보부족_사유": null, "sw_project_quote_원문일치": false, "sw_provider_quote_원문일치": false, "sw_floor_statement_quote_원문일치": false}, "prompt_sha256": "740bf1c46251120a83424d26922ce6300db0e9ac4a9f8aad430407fac8a2241b", "notice_sha256": "a3b240c2c6cfe2469c81128389c1131fb459253b148ad5e25d152a852eddc90b", "command": "api:gpt-6-luna effort=high cache=explicit-30m (tools/luna_api.py)", "elapsed_seconds": 15.164719099993818, "created_at": "2026-09-26T23:46:37.598513+00:00", "raw_sha256": "9dca30d0af8af5134468dd0281f4082a8e621334fda0be70de8a4192b71c942a", "usage": {"usage": {"input_tokens": 7775, "input_tokens_details": {"cache_write_tokens": 0, "cached_tokens": 1799}, "output_tokens": 1809, "output_tokens_details": {"reasoning_tokens": 1667}, "total_tokens": 9584}, "num_turns": 1, "total_cost_usd": 0.00152, "duration_ms": 15164}}
